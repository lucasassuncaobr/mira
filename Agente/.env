# === CONFIGURAÇÕES GERAIS ===
QWEN_ENABLED=1
MIMO_BASE_URL=https://opencode.ai
MIMO_TIMEOUT_SECONDS=4.5
MIMO_FINAL_WAIT_SECONDS=18

# === MODELOS LOCAIS (HuggingFace) ===
